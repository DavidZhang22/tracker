# Keep evaluation artifact hashes identical on Windows and Linux.
backend/ml/datasets/breadth-* text eol=lf
backend/ml/reports/breadth-* text eol=lf
backend/ml/reports/website-breadth.* text eol=lf
# Preserve frozen experiment/model bytes and their recorded hashes.
backend/ml/experiments/breadth-generalization*/*.json -text whitespace=cr-at-eol
backend/app/tracker/link-cascade-model.json -text whitespace=cr-at-eol
backend/ml/datasets/generalization-holdout-* text eol=lf
backend/ml/datasets/generalization-final-* text eol=lf
backend/ml/reports/generalization-upgrade*.json -text whitespace=cr-at-eol
backend/ml/reports/generalization-upgrade*.md text eol=lf
# Freeze CPU decision experiments without checkout newline changes.
backend/ml/experiments/semantic-decision/*.json -text whitespace=cr-at-eol
backend/ml/reports/semantic-decision*.json -text whitespace=cr-at-eol
backend/ml/datasets/semantic-decision* text eol=lf
backend/ml/reports/semantic-decision.md text eol=lf
backend/ml/semantic_decisions/*.py text eol=lf
backend/tests/ml/*.py text eol=lf
backend/ml/**/*.gz binary
