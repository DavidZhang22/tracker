# Copy to deploy/.env. Do not commit the real file.
TRACKER_DOMAIN=your-name.duckdns.org
# 1 allows public signup; 0 requires an invite or private CLI account creation.
TRACKER_PUBLIC_SIGNUP=0
# Optional invite code (at least 20 characters), used only when public signup is off.
TRACKER_SIGNUP_CODE=
# cascade adds a bounded neural rescue pass; on uses the previous classifier.
# Set off to use only the original discovery rules and adapters.
TRACKER_LINK_MODEL=cascade
# Reusable page-analysis processes (0 = threads, 1 or 2 = processes).
TRACKER_ANALYSIS_WORKERS=2
# Optional, only for the explicit YouTube API source method.
TRACKER_YOUTUBE_API_KEY=
# Optional JSON map of exact Ghost hostnames to Content API keys (single-quote the JSON).
TRACKER_GHOST_CONTENT_KEYS='{}'
TRACKER_OPERATOR_NAME=Trackify
TRACKER_PRIVACY_EMAIL=
TRACKER_HOSTING_DESCRIPTION=Microsoft Azure, North Central US (United States)
