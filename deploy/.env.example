# Copy to deploy/.env. Do not commit the real file.
TRACKER_DOMAIN=your-name.duckdns.org
# Leave blank to create accounts only through the private CLI.
# To allow invite-only signup, generate a random code of at least 20 characters.
TRACKER_SIGNUP_CODE=
# Set off to use only the original discovery rules and adapters.
TRACKER_LINK_MODEL=on
# Reusable page-analysis processes (0 = threads, 1 or 2 = processes).
TRACKER_ANALYSIS_WORKERS=2
# Optional, only for the explicit YouTube API source method.
TRACKER_YOUTUBE_API_KEY=
# Optional JSON map of exact Ghost hostnames to Content API keys (single-quote the JSON).
TRACKER_GHOST_CONTENT_KEYS='{}'
