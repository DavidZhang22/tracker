    "positive": "^/[^/]+$",
    "exclude": "^/(?:account|search|products|learning-paths|tutorials|courses|quizzes|podcasts|office-hours|community|team|newsletter|membership|ref|mentor|live|start-here)$",
    "reason": "Tutorial cards; topic and membership navigation excluded."
  },
  {
