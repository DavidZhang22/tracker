  "descriptions": [
    {
      "id": "audit-magnus",
      "method": "semantic-extractive",
      "text": "Rusty Quill is an industry leading independent production company and podcast network. The Magnus Archives is a horror fiction anthology podcast examining what lurks in the archives of the Magnus Institute, an organisation dedicated to researching the esoteric and the weird. Complete rules tailored for a story-based tabletop roleplaying experience in the eerie world of the popular The Magnus Archives horror podcast.",
      "grounded_in_eligible_source_sentences": true,
      "source_sentence_count": 6
    },
    {
      "id": "audit-lightspeed",
      "method": "semantic-extractive",
      "text": "\u00c1nar\u2019s bootheels echoed on the iron floor. Such an honor that it made him leaden to think of, made him long for sleep. There are still hundreds of pages before the end of the book, so they must have had a record of the length of the volume, but lost the text.",
      "grounded_in_eligible_source_sentences": true,
      "source_sentence_count": 20
    },
    {
      "id": "audit-bandcampdaily",
      "method": "semantic-extractive",
      "text": "Bandcamp Daily is your guide to the artists, fans and labels on Bandcamp. Canada\u2019s four Atlantic provinces punch above their weight when it comes to producing guitar pop.",
      "grounded_in_eligible_source_sentences": true,
      "source_sentence_count": 2
    },
    {
      "id": "audit-openlibrary",
      "method": "semantic-extractive",
      "text": "Open Library is an open, editable library catalog, building towards a web page for every book ever published. Read, borrow, and discover more than 3M books for free. See what readers from the community are adding to their bookshelves",
      "grounded_in_eligible_source_sentences": true,
      "source_sentence_count": 3
    },
    {
      "id": "audit-eighty",
      "method": "semantic-extractive",
      "text": "Workflow breakdowns and tutorials for Unreal Engine 4, 3ds Max, Substance Painter, Houdini, and more. 19 September 2026 - Check out the fantastic art style of TheMathewFlames. 18 September 2026 - CD PROJEKT RED\u2019s art directors explain how Night City was handcrafted, how first-person gameplay shaped its scale and detail, why path tracing fit its lighting pipeline, and what Phantom Liberty changed.",
      "grounded_in_eligible_source_sentences": true,
      "source_sentence_count": 9
    },
    {
      "id": "audit-hfpapers",
      "method": "semantic-extractive",
      "text": "Your daily dose of AI research from AK A multi-agent framework using large language models for stock trading simulates real-world trading firms, improving performance metrics like cumulative returns and Sharpe ratio. SmolDocling is a compact vision-language model that performs end-to-end document conversion with robust performance across various document types using 256M parameters and a new markup format.",
      "grounded_in_eligible_source_sentences": true,
      "source_sentence_count": 7
    },
    {
