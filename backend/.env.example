# Optional environment variables; export them in your shell or pass --env-file .env to uvicorn.
# TRACKER_DB=C:/absolute/path/tracker.sqlite3
# TRACKER_HOSTS=localhost,127.0.0.1

# Public deployment: use the exact HTTPS origin and enable account isolation.
# TRACKER_AUTH_REQUIRED=1
# TRACKER_ORIGIN=https://your-name.duckdns.org
# Optional invite-only signup; use a random code of at least 20 characters.
# TRACKER_SIGNUP_CODE=
